---
/**
 * İki Hap, Bir Masa — Murat Bey görüşmesi için karar panosu.
 *
 * Rehberin parçası değildir: kenar çubuğunda ve site haritasında yoktur (astro.config.mjs),
 * arama motorlarına kapalıdır (noindex) ve Pagefind dizinine girmez (data-pagefind-body yok).
 * Maliyet rakamları derleme anında src/lib/bordro.ts modelinden üretilir; elle yazılmış rakam yoktur.
 */
import '@fontsource-variable/roboto';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/caveat';
import '../styles/iki-hap.scss';
import PhIcon from '../components/PhIcon.astro';
import { bordroHesapla, yuzdeDagit, type BordroGirdisi } from '../lib/bordro';

/* ---- Hesap: 2027 merkez tahmin ---- */
const merkez: BordroGirdisi = {
  netUsd: 5_000,
  yemekTl: 7_500,
  kurOcak: 51.5,
  kurAralik: 59.5,
  artisYuzde: 25,
  indirim: true,
};
const sonuc = bordroHesapla(merkez);

/** Ayda iş günü. Kırmızı yoldaki günlük ücret de bu varsayımla belirlendi (10.000 $ / 22). */
const IS_GUNU = 22;
const KIRMIZI_GUNLUK = 455;
const aylikUsd = sonuc.usd.toplam / 12;
const gunlukUsd = sonuc.usd.toplam / (12 * IS_GUNU);
const kirmiziAylik = (KIRMIZI_GUNLUK * 52) / 12;

const sayi = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
const ondalik = (x: number, basamak: number) =>
  new Intl.NumberFormat('tr-TR', {
    minimumFractionDigits: basamak,
    maximumFractionDigits: basamak,
  }).format(x);
const yuvarla = (x: number, adim: number) => Math.round(x / adim) * adim;
const usd = (x: number) => `${sayi.format(Math.round(x))} $`;
const tl = (x: number) => `${sayi.format(Math.round(x))} ₺`;

const aylikYuvarlak = usd(yuvarla(aylikUsd, 100));
const yillikYuvarlak = usd(yuvarla(sonuc.usd.toplam, 100));
const gunlukYuvarlak = usd(gunlukUsd);
const kirmiziAylikYuvarlak = usd(yuvarla(kirmiziAylik, 10));
const netBasina = ondalik(sonuc.usd.toplam / sonuc.usd.net, 2);
const aylikKat = Math.round(aylikUsd / kirmiziAylik);
const isverenYuzde = ondalik(sonuc.isverenPayi * 100, 2);
const ilkBrutBin = sayi.format(Math.round((sonuc.aylar[0]?.brut ?? 0) / 1000));
const sonBrutBin = sayi.format(Math.round((sonuc.aylar.at(-1)?.brut ?? 0) / 1000));

/* Her 100 $'ın dağılımı: çalışana giden, maaştan kesilen, işverenin ayrıca ödediği */
const eline = sonuc.usd.net + sonuc.usd.yemek;
const kesinti = sonuc.usd.isciPayi + sonuc.usd.gelirVergisi + sonuc.usd.damgaVergisi;
const isverenPrimi = sonuc.usd.isverenPayi;
const [payEline = 0, payKesinti = 0, payIsveren = 0] = yuzdeDagit([eline, kesinti, isverenPrimi]);
const dagilim = [
  {
    sinif: 'renk--eline',
    ad: 'Çalışanın eline geçen',
    ayrinti: 'net maaş ve yemek parası',
    pay: payEline,
  },
  {
    sinif: 'renk--kesinti',
    ad: 'Maaştan kesilip devlete ödenen',
    ayrinti: 'SGK ve işsizlik %15, gelir ve damga vergisi',
    pay: payKesinti,
  },
  {
    sinif: 'renk--isveren',
    ad: 'İşverenin ayrıca ödediği prim',
    ayrinti: `SGK ve işsizlik, işveren payı %${isverenYuzde}`,
    pay: payIsveren,
  },
];

type SatirTuru = 'ana' | 'alt' | 'toplam';
const dokum: { ad: string; tl: number; usd: number; tur: SatirTuru }[] = [
  { ad: 'Brüt ücret', tl: sonuc.tl.brut, usd: sonuc.usd.brut, tur: 'ana' },
  { ad: 'Çalışana net', tl: sonuc.tl.net, usd: sonuc.usd.net, tur: 'alt' },
  { ad: 'SGK ve işsizlik, işçi payı (%15)', tl: sonuc.tl.isciPayi, usd: sonuc.usd.isciPayi, tur: 'alt' },
  { ad: 'Gelir vergisi (istisna sonrası)', tl: sonuc.tl.gelirVergisi, usd: sonuc.usd.gelirVergisi, tur: 'alt' },
  { ad: 'Damga vergisi (binde 7,59)', tl: sonuc.tl.damgaVergisi, usd: sonuc.usd.damgaVergisi, tur: 'alt' },
  { ad: `SGK ve işsizlik, işveren payı (%${isverenYuzde})`, tl: sonuc.tl.isverenPayi, usd: sonuc.usd.isverenPayi, tur: 'ana' },
  { ad: `Yemek parası (12 × ${tl(merkez.yemekTl)})`, tl: sonuc.tl.yemek, usd: sonuc.usd.yemek, tur: 'ana' },
  { ad: 'Toplam işveren maliyeti', tl: sonuc.tl.toplam, usd: sonuc.usd.toplam, tur: 'toplam' },
];

interface Senaryo {
  ad: string;
  girdi: BordroGirdisi;
  vurgu?: boolean;
}
const senaryolar = (
  [
    { ad: 'Bugün işe alınsa: 2026 kuralları, kur 49 ₺/$', girdi: { ...merkez, kurOcak: 49, kurAralik: 49, artisYuzde: 0 } },
    { ad: '2027 merkez tahmin', girdi: merkez, vurgu: true },
    { ad: 'Kur yıl boyu 52 ₺/$ kalırsa', girdi: { ...merkez, kurOcak: 52, kurAralik: 52 } },
    { ad: 'TL parametre artışı %20 olursa', girdi: { ...merkez, artisYuzde: 20 } },
    { ad: 'TL parametre artışı %30 olursa', girdi: { ...merkez, artisYuzde: 30 } },
    { ad: 'SGK işveren indirimi alınamazsa', girdi: { ...merkez, indirim: false } },
  ] satisfies Senaryo[]
).map((s): Senaryo & { yillik: number } => ({ ...s, yillik: bordroHesapla(s.girdi).usd.toplam }));
const yilliklar = senaryolar.map((s) => s.yillik);
const bantAlt = Math.floor(Math.min(...yilliklar) / 1000);
const bantUst = Math.ceil(Math.max(...yilliklar) / 1000);

/* İki yol yan yana: aynı ölçekli küçük çoklu grafik (iki ayrı grafik, tek eksen) */
type Ton = 'mavi' | 'kirmizi';
const karsilastirma: {
  baslik: string;
  olcek: number;
  olcekMetni: string;
  satirlar: { ton: Ton; ad: string; deger: number; metin: string; ayrinti: string }[];
}[] = [
  {
    baslik: 'Aylık ödeme',
    olcek: 10_000,
    olcekMetni: '0 – 10.000 $',
    satirlar: [
      { ton: 'mavi', ad: 'Mavi yol', deger: aylikUsd, metin: `≈ ${aylikYuvarlak}`, ayrinti: 'haftada 5 gün, tam zamanlı' },
      { ton: 'kirmizi', ad: 'Kırmızı yol', deger: kirmiziAylik, metin: `≈ ${kirmiziAylikYuvarlak}`, ayrinti: 'haftada 1 gün, öğleden önce' },
    ],
  },
  {
    baslik: 'İş günü başına',
    olcek: 500,
    olcekMetni: '0 – 500 $',
    satirlar: [
      { ton: 'mavi', ad: 'Mavi yol', deger: gunlukUsd, metin: `≈ ${gunlukYuvarlak}`, ayrinti: 'yıllık maliyet / 264 iş günü' },
      { ton: 'kirmizi', ad: 'Kırmızı yol', deger: KIRMIZI_GUNLUK, metin: usd(KIRMIZI_GUNLUK), ayrinti: '10.000 $ / 22 iş günü' },
    ],
  },
];

/* ---- Pano içeriği (müzakere kartındaki cümleler) ---- */
type Ek = 'hesap' | 'karsilastir';
interface Not {
  ikon: string;
  etiket: string;
  metin: string;
  vurgu?: string;
  ek?: Ek;
}

const maviNotlar: Not[] = [
  { ikon: 'currency-circle-dollar', etiket: 'Ücret', vurgu: '5.000 $ net maaş.', metin: '', ek: 'hesap' },
  {
    ikon: 'target',
    etiket: 'Çalışma modeli',
    metin:
      'Seninle yalnız hedefleri konuşuruz, teknik detayı değil. Bütçeyi ben çıkarırım; sen onaylarsın ya da revizyon istersin. Aradaki süreçte müdahale yok — bana güvenmen şart.',
  },
  {
    ikon: 'wallet',
    etiket: 'Bütçe yetkisi',
    metin: 'Bana bir üst limit tanımlarız. Limitin altındaki kararlar bende; aşarsa sana onaya gelirim.',
  },
  {
    ikon: 'buildings',
    etiket: 'Önce şu karar',
    metin: 'Patron şirketi mi kalacağız, kurumsal mı olacağız? Bunu sen netleştireceksin; model buna göre işler.',
  },
];

const kirmiziNotlar: Not[] = [
  {
    ikon: 'currency-circle-dollar',
    etiket: 'Ücret',
    vurgu: `Günlük ${usd(KIRMIZI_GUNLUK)}`,
    metin: `(10.000 $ / ${IS_GUNU} iş günü). Haftada 1 gün ≈ ayda ${kirmiziAylikYuvarlak}.`,
    ek: 'karsilastir',
  },
  {
    ikon: 'users-three',
    etiket: 'Yöntem',
    metin: 'Mevcut yazılım ekibini Scrum ile uzaktan yönetirim; rolüm dışarıdan agile coach.',
  },
  {
    ikon: 'sun-horizon',
    etiket: 'Kapsam',
    metin:
      'Haftada 1 gün, yalnız öğleden önce, yalnız seninle yazılım süreç toplantısı. Başka iş, başka toplantı yok.',
  },
  {
    ikon: 'hourglass-medium',
    etiket: 'Süre',
    metin: "En geç 31 Aralık 2026'ya kadar. Sonrası için söz vermiyorum.",
  },
];

const dongu = [
  'Onlarca strateji üretiyorum',
  'Onaylanmıyor',
  'Bütçe belirlenip vazgeçiliyor',
  'Dokümanlara birlikte bakmıyoruz',
  'Sabır bitiyor',
  '“İsmail, tekrar plan yap.”',
];

const kaynaklar = [
  { ad: 'EY: 2026 asgari ücret ve işveren maliyeti', url: 'https://www.ey.com/tr_tr/insights/tax/2026-asgari-ucret' },
  {
    ad: 'SGK: 2026 prime esas kazanç miktarları',
    url: 'https://www.sgk.gov.tr/Content/Post/2e0c9e1a-2cfe-4456-af10-49d3de0c58ba/Prime-Esas-Kazanc-Miktarlari-2026-01-14-10-35-39',
  },
  {
    ad: 'İSMMMO: SGK tavanını 9 kata çıkaran düzenleme',
    url: 'https://ismmmo.org.tr/dosya/5782/Mevzuat-Dosya/22122025-sgk-duyuru.pdf',
  },
  {
    ad: 'Verginet / Deloitte: 2026 SGK tavanı ve işveren prim indirimleri',
    url: 'https://www.verginet.net/dtt/11/sgk-2026-1.aspx',
  },
  {
    ad: 'Alomaliye: 2026 gelir vergisi tarifesi',
    url: 'https://www.alomaliye.com/2025/12/31/2026-yili-vergi-dilimleri/',
  },
  {
    ad: 'Kolay İK: 2026 yemek ve yol istisna tutarları',
    url: 'https://kolayik.com/blog/2026-gunluk-yemek-ve-yol-istisna-tutarlari',
  },
  {
    ad: 'Dünya: TCMB Eylül 2026 Piyasa Katılımcıları Anketi',
    url: 'https://www.dunya.com/ekonomik-veriler/tcmb-anketinde-enflasyon-beklentisi-yukseldi-dolar-ve-faiz-tahmini-de-belli-oldu-haberi-839608',
  },
];

const aciklamaMetni =
  'Murat abi için iki yol: mavi hap ve kırmızı hap, altındaki şartlar ve maliyet hesabı.';
const favicon = `data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><g transform="rotate(-35 32 32)"><rect x="6" y="19" width="52" height="26" rx="13" fill="#e34948"/><path d="M19 19h13v26H19a13 13 0 0 1 0-26z" fill="#2a78d6"/><rect x="12" y="24" width="14" height="4" rx="2" fill="#fff" opacity=".55"/></g></svg>'
)}`;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>İki Hap, Bir Masa</title>
    <meta name="description" content={aciklamaMetni} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="İki Hap, Bir Masa" />
    <meta property="og:description" content={aciklamaMetni} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#eceef2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13161c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {/* Rehberle aynı tema anahtarı: rehberde seçilen tema burada da geçerli olur. */}
    <script is:inline>
      (() => {
        let secilen = null;
        try {
          secilen = localStorage.getItem('starlight-theme');
        } catch (e) {}
        const tema =
          secilen === 'light' || secilen === 'dark'
            ? secilen
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = tema;
      })();
    </script>
  </head>
  <body>
    <div class="sayfa">
      <header class="ust">
        <div class="ust__kimlik">
          <span class="logo" aria-hidden="true">
            <span class="kapsul kapsul--mavi"></span>
            <span class="kapsul kapsul--kirmizi"></span>
          </span>
          <div>
            <p class="ust__ust-baslik">Karar panosu · Murat Bey görüşmesi</p>
            <h1>İki Hap, Bir Masa</h1>
          </div>
        </div>
        <div class="ust__sag">
          <div class="avatarlar" role="img" aria-label="Masada iki kişi: İsmail ve Murat abi">
            <span class="avatar" aria-hidden="true">İ</span>
            <span class="avatar avatar--m" aria-hidden="true">M</span>
          </div>
          <button type="button" class="ikon-dugme tema-dugme" data-tema-dugme aria-label="Temayı değiştir">
            <PhIcon name="moon" size={20} class="ikon ikon--ay" />
            <PhIcon name="sun" size={20} class="ikon ikon--gunes" />
          </button>
        </div>
      </header>

      <main class="pano" id="pano" data-secim="hepsi">
        <p class="gorsel-gizli">
          Bu pano bir karar ağacıdır. Açılış cümlesinden üç yol çıkar: mavi hap, kırmızı hap ve
          masada olmayan eski düzen. Mavi ve kırmızı yol kapanış cümlesinde birleşir. Alttaki
          araç çubuğundan bir hap seçilebilir.
        </p>

        <svg class="teller" aria-hidden="true" focusable="false">
          <defs>
            {
              (['mavi', 'kirmizi', 'gri'] as const).map((ton) => (
                <marker
                  id={`ok-${ton}`}
                  viewBox="0 0 10 10"
                  refX="8.5"
                  refY="5"
                  markerWidth="10"
                  markerHeight="10"
                  markerUnits="userSpaceOnUse"
                  orient="auto-start-reverse"
                >
                  <path class={`ok--${ton}`} d="M0 0.8 L9.5 5 L0 9.2 Z" />
                </marker>
              ))
            }
          </defs>
          <g class="teller__yollar"></g>
        </svg>
        <div class="tel-etiketleri" aria-hidden="true"></div>

        <section class="masa kagit" id="masa" aria-labelledby="masa-etiket">
          <span class="bant" aria-hidden="true"></span>
          <p class="kagit__etiket" id="masa-etiket">
            <PhIcon name="signpost" size={18} class="ikon" />
            Açılış
          </p>
          <blockquote class="alinti">
            <p>
              Murat abi, önüne iki yol koyuyorum. İkisinde de varım, ikisi de dürüst. Üçüncü seçenek
              eski düzenin devamı değil.
            </p>
          </blockquote>
        </section>

        <div class="catal">
          <button type="button" class="bas bas--mavi" id="bas-mavi" data-secim-dugme="mavi" aria-pressed="false">
            <span class="kapsul kapsul--mavi" aria-hidden="true"></span>
            <span class="bas__metin">
              <span class="bas__ad">Mavi hap</span>
              <span class="bas__slogan">Kalıyorum, düzeni yeniden kuruyoruz</span>
            </span>
            <span class="bas__durum" aria-hidden="true">
              <span class="durum-cipi">
                <span class="durum-cipi__sec">Bunu seç</span>
                <span class="durum-cipi__secildi"><PhIcon name="check" size={16} class="ikon" />Seçildi</span>
              </span>
            </span>
            <span class="muhur" aria-hidden="true"><PhIcon name="seal-check" size={22} class="ikon" /></span>
          </button>

          <div class="bas bas--eski" id="bas-eski">
            <span class="kapsul kapsul--eski" aria-hidden="true"><span class="kapsul__cizik"></span></span>
            <span class="bas__metin">
              <span class="bas__ad">Eski düzen</span>
              <span class="bas__slogan">Bugünkü döngünün devamı</span>
            </span>
            <span class="damga"><PhIcon name="prohibit" size={16} class="ikon" />Masada yok</span>
          </div>

          <button type="button" class="bas bas--kirmizi" id="bas-kirmizi" data-secim-dugme="kirmizi" aria-pressed="false">
            <span class="kapsul kapsul--kirmizi" aria-hidden="true"></span>
            <span class="bas__metin">
              <span class="bas__ad">Kırmızı hap</span>
              <span class="bas__slogan">Dışarıdan koç, yıl sonuna kadar</span>
            </span>
            <span class="bas__durum" aria-hidden="true">
              <span class="durum-cipi">
                <span class="durum-cipi__sec">Bunu seç</span>
                <span class="durum-cipi__secildi"><PhIcon name="check" size={16} class="ikon" />Seçildi</span>
              </span>
            </span>
            <span class="muhur" aria-hidden="true"><PhIcon name="seal-check" size={22} class="ikon" /></span>
          </button>
        </div>

        <div class="dallar">
          <section class="dal dal--mavi" id="dal-mavi" aria-labelledby="dal-mavi-baslik">
            <div class="dal__baslik">
              <span class="kapsul kapsul--mavi" aria-hidden="true"></span>
              <h2 id="dal-mavi-baslik">
                Mavi hap
                <small>Kalıyorum, düzeni yeniden kuruyoruz</small>
              </h2>
            </div>
            <ul class="notlar">
              {
                maviNotlar.map((n) => (
                  <li class="not not--mavi kagit">
                    <p class="kagit__etiket">
                      <PhIcon name={n.ikon} size={18} class="ikon" />
                      {n.etiket}
                    </p>
                    <p class="not__metin">
                      {n.vurgu && <b>{n.vurgu}</b>} {n.metin}
                    </p>
                    {n.ek === 'hesap' && (
                      <div class="not__alt">
                        <span class="not__cip">İşverene maliyeti ≈ {aylikYuvarlak}/ay</span>
                        <button type="button" class="kagit-dugme" data-hesap-ac aria-haspopup="dialog">
                          <PhIcon name="calculator" size={18} class="ikon" />
                          Hesabı aç
                        </button>
                      </div>
                    )}
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="dal dal--kirmizi" id="dal-kirmizi" aria-labelledby="dal-kirmizi-baslik">
            <div class="dal__baslik">
              <span class="kapsul kapsul--kirmizi" aria-hidden="true"></span>
              <h2 id="dal-kirmizi-baslik">
                Kırmızı hap
                <small>Dışarıdan koç, yıl sonuna kadar</small>
              </h2>
            </div>
            <ul class="notlar">
              {
                kirmiziNotlar.map((n) => (
                  <li class="not not--kirmizi kagit">
                    <p class="kagit__etiket">
                      <PhIcon name={n.ikon} size={18} class="ikon" />
                      {n.etiket}
                    </p>
                    <p class="not__metin">
                      {n.vurgu && <b>{n.vurgu}</b>} {n.metin}
                    </p>
                    {n.ek === 'karsilastir' && (
                      <div class="not__alt">
                        <button
                          type="button"
                          class="kagit-dugme"
                          data-hesap-ac="karsilastirma"
                          aria-haspopup="dialog"
                        >
                          <PhIcon name="scales" size={18} class="ikon" />
                          Mavi ile yan yana
                        </button>
                      </div>
                    )}
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="dal dal--eski" id="dal-eski" aria-labelledby="dal-eski-baslik">
            <div class="dal__baslik">
              <PhIcon name="arrows-clockwise" size={22} class="ikon" />
              <h2 id="dal-eski-baslik">
                Bugünkü döngü
                <small>Eski düzenin devamı: masada yok</small>
              </h2>
            </div>
            <ol class="dongu">
              {
                dongu.map((adim, i) => (
                  <li
                    class:list={['dongu__adim', 'kagit', { 'dongu__adim--son': i === dongu.length - 1 }]}
                    id={`dongu-${i + 1}`}
                  >
                    {adim}
                  </li>
                ))
              }
            </ol>
            <div class="dongu__not">
              <p>Bu döngü ikimize de para kaybettiriyor.</p>
              <p class="el-yazisi">Mavi yoldaki düzenin gerekçesi bu döngü.</p>
            </div>
          </section>
        </div>

        <section class="kapanis kagit" id="kapanis" aria-labelledby="kapanis-etiket">
          <span class="bant" aria-hidden="true"></span>
          <p class="kagit__etiket" id="kapanis-etiket">
            <PhIcon name="handshake" size={18} class="ikon" />
            Kapanış
          </p>
          <blockquote class="alinti">
            <p>
              Karar senin Murat abi.{' '}
