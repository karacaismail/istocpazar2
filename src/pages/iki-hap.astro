    <template id="rozet-sablonu">
      <span class="tel-rozet"><PhIcon name="prohibit" size={16} class="ikon" /></span>
    </template>

    <script>
      type Secim = 'hepsi' | 'mavi' | 'kirmizi';
      type TelTonu = 'mavi' | 'kirmizi' | 'gri';
      type Kenar = 'ust' | 'alt' | 'sag';

      interface Nokta {
        x: number;
        y: number;
      }

      interface Tel {
        kaynak: string;
        hedef: string;
        ton: TelTonu;
        kaynakKenar?: Kenar;
        hedefKenar?: Kenar;
        /** Bağlantı noktasının öğe genişliğine oranla yatay kayması (-0,5 ile 0,5 arası). */
        kaynakKayma?: number;
        hedefKayma?: number;
        etiket?: string;
        /** Etiketin dönüş açısı, derece. */
        etiketAcisi?: number;
        /** Etiket gri bölümün üstündeyse zemini ona uyar. */
        kutuIci?: boolean;
        kesikli?: boolean;
        /** Tel ortasına "yasak" rozeti koyar. */
        yasak?: boolean;
        /** Yan yaylarda dışa taşma, piksel. */
        bombe?: number;
        /** Yalnızca üç sütunlu geniş yerleşimde çizilir. */
        genis?: boolean;
      }

      const TELLER: Tel[] = [
        { kaynak: '#masa', hedef: '#bas-mavi', ton: 'mavi', kaynakKayma: -0.28, etiket: '1. yol' },
        { kaynak: '#masa', hedef: '#bas-eski', ton: 'gri', kesikli: true, yasak: true },
        { kaynak: '#masa', hedef: '#bas-kirmizi', ton: 'kirmizi', kaynakKayma: 0.28, etiket: '2. yol' },
        { kaynak: '#bas-mavi', hedef: '#dal-mavi', ton: 'mavi', genis: true },
        { kaynak: '#bas-eski', hedef: '#dal-eski', ton: 'gri', kesikli: true, genis: true },
        { kaynak: '#bas-kirmizi', hedef: '#dal-kirmizi', ton: 'kirmizi', genis: true },
        { kaynak: '#dal-mavi', hedef: '#kapanis', ton: 'mavi', hedefKayma: -0.24, etiket: 'seçilirse', genis: true },
        { kaynak: '#dal-kirmizi', hedef: '#kapanis', ton: 'kirmizi', hedefKayma: 0.24, etiket: 'seçilirse', genis: true },
        { kaynak: '#dongu-1', hedef: '#dongu-2', ton: 'gri' },
        { kaynak: '#dongu-2', hedef: '#dongu-3', ton: 'gri' },
        { kaynak: '#dongu-3', hedef: '#dongu-4', ton: 'gri' },
        { kaynak: '#dongu-4', hedef: '#dongu-5', ton: 'gri' },
        { kaynak: '#dongu-5', hedef: '#dongu-6', ton: 'gri' },
        {
          kaynak: '#dongu-6',
          hedef: '#dongu-1',
          ton: 'gri',
          kaynakKenar: 'sag',
          hedefKenar: 'sag',
          bombe: 40,
          etiket: 'başa dön',
          etiketAcisi: -90,
          kutuIci: true,
        },
      ];

      const SVG_NS = 'http://www.w3.org/2000/svg';
      const pano = document.getElementById('pano');
      const svg = pano?.querySelector<SVGSVGElement>('.teller') ?? null;
      const yollar = svg?.querySelector<SVGGElement>('.teller__yollar') ?? null;
      const etiketler = pano?.querySelector<HTMLElement>('.tel-etiketleri') ?? null;
      const rozetSablonu = document.getElementById('rozet-sablonu');
      const genisEkran = window.matchMedia('(min-width: 64rem)');
      const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)');

      function baglantiNoktasi(el: Element, kenar: Kenar, kayma: number, koken: DOMRect): Nokta {
        const r = el.getBoundingClientRect();
        const x = r.left - koken.left + r.width * (0.5 + kayma);
        if (kenar === 'ust') return { x, y: r.top - koken.top };
        if (kenar === 'alt') return { x, y: r.bottom - koken.top };
        return { x: r.right - koken.left, y: r.top - koken.top + r.height / 2 };
      }

      /** Bağlantı tellerini güncel yerleşime göre yeniden çizer. */
      function telleriCiz(): void {
        if (!pano || !svg || !yollar || !etiketler) return;
        const koken = pano.getBoundingClientRect();
        const genislik = pano.offsetWidth;
        const yukseklik = pano.offsetHeight;
        svg.setAttribute('width', String(genislik));
        svg.setAttribute('height', String(yukseklik));
        svg.setAttribute('viewBox', `0 0 ${genislik} ${yukseklik}`);
        yollar.replaceChildren();
        etiketler.replaceChildren();
        const genis = genisEkran.matches;

        for (const tel of TELLER) {
          if (tel.genis && !genis) continue;
          const kaynak = pano.querySelector(tel.kaynak);
          const hedef = pano.querySelector(tel.hedef);
          if (!kaynak || !hedef) continue;

          const kaynakKenar = tel.kaynakKenar ?? 'alt';
          const a = baglantiNoktasi(kaynak, kaynakKenar, tel.kaynakKayma ?? 0, koken);
          const b = baglantiNoktasi(hedef, tel.hedefKenar ?? 'ust', tel.hedefKayma ?? 0, koken);
          let c1: Nokta;
          let c2: Nokta;
          if (kaynakKenar === 'sag') {
            const bombe = tel.bombe ?? 32;
            a.x += 4;
            b.x += 5;
            c1 = { x: a.x + bombe, y: a.y };
            c2 = { x: b.x + bombe, y: b.y };
          } else {
            a.y += 3;
            b.y -= 4;
            const k = Math.max(10, (b.y - a.y) * 0.55);
            c1 = { x: a.x, y: a.y + k };
            c2 = { x: b.x, y: b.y - k };
          }

          const yol = document.createElementNS(SVG_NS, 'path');
          yol.setAttribute('d', `M ${a.x} ${a.y} C ${c1.x} ${c1.y}, ${c2.x} ${c2.y}, ${b.x} ${b.y}`);
          yol.setAttribute('class', `tel tel--${tel.ton}${tel.kesikli ? ' tel--kesikli' : ''}`);
          yol.setAttribute('marker-end', `url(#ok-${tel.ton})`);
          yollar.append(yol);

          // Kübik Bézier eğrisinin t = 0,5 noktası
          const orta: Nokta = {
            x: 0.125 * a.x + 0.375 * c1.x + 0.375 * c2.x + 0.125 * b.x,
            y: 0.125 * a.y + 0.375 * c1.y + 0.375 * c2.y + 0.125 * b.y,
          };

          if (tel.yasak && rozetSablonu instanceof HTMLTemplateElement) {
            const rozet = rozetSablonu.content.firstElementChild?.cloneNode(true);
            if (rozet instanceof HTMLElement) {
              rozet.style.left = `${orta.x}px`;
              rozet.style.top = `${orta.y}px`;
              etiketler.append(rozet);
            }
          }

          if (tel.etiket) {
            const etiket = document.createElement('span');
            etiket.className = `tel-etiket tel-etiket--${tel.ton}${tel.kutuIci ? ' tel-etiket--kutu' : ''}`;
            etiket.textContent = tel.etiket;
            etiket.style.left = `${orta.x}px`;
            etiket.style.top = `${orta.y}px`;
            if (tel.etiketAcisi) {
              etiket.style.transform = `translate(-50%, -50%) rotate(${tel.etiketAcisi}deg)`;
            }
            etiketler.append(etiket);
          }
        }
      }

      let bekleyenCizim = 0;
      function yenidenCiz(): void {
        cancelAnimationFrame(bekleyenCizim);
        bekleyenCizim = requestAnimationFrame(telleriCiz);
      }

      if (pano) {
        const gozlemci = new ResizeObserver(yenidenCiz);
        gozlemci.observe(pano);
        pano.querySelectorAll('.masa, .bas, .dal, .dongu__adim, .kapanis').forEach((el) => gozlemci.observe(el));
      }
      genisEkran.addEventListener('change', yenidenCiz);
      void document.fonts.ready.then(yenidenCiz);
      window.addEventListener('load', yenidenCiz);
      telleriCiz();

      /* ---- Hap seçimi ---- */
      const secimDugmeleri = document.querySelectorAll<HTMLButtonElement>('[data-secim-dugme]');
      const duyuru = document.getElementById('secim-duyurusu');

      function yoluCizdir(ton: 'mavi' | 'kirmizi'): void {
        if (azHareket.matches || !yollar) return;
        yollar.querySelectorAll<SVGPathElement>(`.tel--${ton}`).forEach((yol) => {
          const uzunluk = yol.getTotalLength();
          yol.animate(
            [
              { strokeDasharray: `${uzunluk}`, strokeDashoffset: `${uzunluk}` },
              { strokeDasharray: `${uzunluk}`, strokeDashoffset: '0' },
            ],
            { duration: 650, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
          );
        });
      }

      function secimYap(secim: Secim): void {
        if (!pano) return;
        pano.dataset.secim = secim;
        secimDugmeleri.forEach((d) => {
          d.setAttribute('aria-pressed', String(d.dataset.secimDugme === secim));
        });
        if (duyuru) {
          duyuru.textContent =
            secim === 'hepsi'
              ? 'İki yol birlikte gösteriliyor.'
              : secim === 'mavi'
                ? 'Mavi hap seçildi.'
                : 'Kırmızı hap seçildi.';
        }
        if (secim !== 'hepsi') yoluCizdir(secim);
      }

      secimDugmeleri.forEach((d) => {
        d.addEventListener('click', () => {
          const istenen = d.dataset.secimDugme;
          if (istenen !== 'hepsi' && istenen !== 'mavi' && istenen !== 'kirmizi') return;
          // Basılı bir hapa yeniden basmak seçimi kaldırır.
          const simdiki = pano?.dataset.secim;
          secimYap(istenen !== 'hepsi' && simdiki === istenen ? 'hepsi' : istenen);
        });
      });

      /* ---- Hesap çekmecesi ---- */
      const cekmece = document.getElementById('hesap');
      if (cekmece instanceof HTMLDialogElement) {
        const govde = cekmece.querySelector<HTMLElement>('.cekmece__govde');
        document.querySelectorAll<HTMLButtonElement>('[data-hesap-ac]').forEach((d) => {
          d.addEventListener('click', () => {
            cekmece.showModal();
            const hedefId = d.dataset.hesapAc;
            const hedef = hedefId ? cekmece.querySelector<HTMLElement>(`#${hedefId}`) : null;
            if (hedef) hedef.scrollIntoView({ block: 'start' });
            else if (govde) govde.scrollTop = 0;
          });
        });
        cekmece.querySelector('[data-hesap-kapat]')?.addEventListener('click', () => cekmece.close());
        // Arka plana tıklamak çekmeceyi kapatır.
        cekmece.addEventListener('click', (e) => {
          if (e.target === cekmece) cekmece.close();
        });
      }

      /* ---- Tema ---- */
      const temaDugmesi = document.querySelector<HTMLButtonElement>('[data-tema-dugme]');
      function temaEtiketiniYaz(): void {
        if (!temaDugmesi) return;
        const koyu = document.documentElement.dataset.theme === 'dark';
        temaDugmesi.setAttribute('aria-label', koyu ? 'Açık temaya geç' : 'Koyu temaya geç');
        temaDugmesi.title = koyu ? 'Açık tema' : 'Koyu tema';
      }
      temaDugmesi?.addEventListener('click', () => {
        const yeni = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = yeni;
        try {
          localStorage.setItem('starlight-theme', yeni);
        } catch {
          // Depolama kapalıysa tema yalnızca bu oturumda geçerli olur.
        }
        temaEtiketiniYaz();
      });
      temaEtiketiniYaz();

      /* ---- Tam ekran (sunum için) ---- */
      const tamEkranDugmesi = document.querySelector<HTMLButtonElement>('[data-tam-ekran]');
      if (tamEkranDugmesi) {
        const etiket = tamEkranDugmesi.querySelector('[data-tam-ekran-etiket]');
        if (!document.fullscreenEnabled) tamEkranDugmesi.hidden = true;
        tamEkranDugmesi.addEventListener('click', () => {
          const islem = document.fullscreenElement
            ? document.exitFullscreen()
            : document.documentElement.requestFullscreen();
          islem.catch(() => {
            // Tarayıcı tam ekranı reddedebilir; pano normal görünümde kalır.
          });
        });
        document.addEventListener('fullscreenchange', () => {
          const acik = document.fullscreenElement !== null;
          tamEkranDugmesi.setAttribute('aria-pressed', String(acik));
          if (etiket) etiket.textContent = acik ? 'Tam ekrandan çık' : 'Tam ekran';
        });
      }
    </script>
  </body>
</html>
